/**app.wxss**/
.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 200rpx 0;
  box-sizing: border-box;
  background-color: #f5f7fa;
} 
/*新闻列表区域样式*/
/*2-1新闻列表容器*/
#news-list {
  min-height: 600rpx;
  padding: 15rpx;
  border-radius: 24rpx;
  background-color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  margin: 15rpx;
}
/*2-2列表项目*/
.list-item{
  display: flex;
  flex-direction: row;
  border-bottom: 1rpx solid gray;
  padding: 16rpx 8rpx;
  margin-bottom: 12rpx;
  background-color: #fafafa;
  border-radius: 16rpx;
  transition: all 0.2s;
}
.list-item:active{
  background-color: #eef1f6;
}
/*2-3新闻图片*/
.list-item image{
  width: 260rpx;
  height: 150rpx;
  margin: 10rpx;
  border-radius: 12rpx;
  object-fit: cover;
}
/*2-4新闻标题*/
.list-item text{
  width: 100%;
  line-height: 50rpx;
  font-size: 12pt;
  margin-left: 10rpx;
  color: #2c2c2c;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}