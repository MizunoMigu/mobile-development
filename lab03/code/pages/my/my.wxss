page {
  background: linear-gradient(180deg, #eaf4ff 0%, #f7fbff 100%);
}

.container {
  background: transparent;
  padding: 20rpx;
  box-sizing: border-box;
}
/*登录面板*/
#myLogin{
  background-color: #6FA8DC;
  height: 400rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-around;
  box-sizing: border-box;
}
/*1-1头像图片*/
/* #myIcon{
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
} */
.avatar-btn{
  width:200rpx;
  height:200rpx;
  padding: 0;
  border-radius: 50%;
  margin: 0, auto;
  background: transparent;
}
.avatar-btn::after{
  border:none !important;
}
#myIcon{
  width:200rpx;
  height:200rpx;
  border-radius:50%;
  /* display: block; */
}

/*1-2微信昵称*/
#nickName{
  color: white;
  font-weight: 500;
}
/*我的收藏*/
#myFavorites{
  padding: 20rpx;
}