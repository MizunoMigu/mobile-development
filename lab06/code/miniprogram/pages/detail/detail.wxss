.detail-page {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx 20rpx 60rpx;
}

.photo-panel {
  overflow: hidden;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 32rpx;
  box-shadow: 0 20rpx 56rpx rgba(103, 83, 168, 0.2);
}

.photo {
  display: block;
  width: 710rpx;
  min-height: 260rpx;
  background: #e9e5f3;
}

.meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 30rpx;
}

.meta-name {
  color: #303249;
  font-size: 29rpx;
  font-weight: 600;
}

.meta-author {
  display: flex;
  align-items: center;
  min-width: 0;
}

.meta-tag {
  flex: none;
  margin-left: 16rpx;
  padding: 7rpx 15rpx;
  color: #7657d9;
  font-size: 21rpx;
  line-height: 1;
  background: #f0eaff;
  border-radius: 999rpx;
}

.meta-date {
  color: #8d8fa3;
  font-size: 24rpx;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 28rpx 0 0;
}

.action-button {
  display: flex;
  flex: 0 0 218rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 158rpx;
  margin: 0;
  padding: 0;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.2;
  border-radius: 26rpx;
  box-shadow: 0 14rpx 34rpx rgba(84, 62, 147, 0.22);
}

.owner-actions .action-button {
  flex-basis: 330rpx;
}

.action-icon {
  margin-bottom: 12rpx;
  font-size: 42rpx;
  font-weight: 400;
}

.download-button {
  background: linear-gradient(145deg, #697fe8, #8b6cf4);
}

.share-button {
  background: linear-gradient(145deg, #ee6fa0, #ff8c85);
}

.preview-button {
  background: linear-gradient(145deg, #45b6b2, #68c99e);
}

.delete-button {
  background: linear-gradient(145deg, #e65d72, #f27a66);
}
