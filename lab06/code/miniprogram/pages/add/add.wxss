.add-page {
  align-items: stretch;
  padding-top: 28rpx;
}

.upload-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  width: 710rpx;
  padding: 46rpx 34rpx 40rpx;
  color: #ffffff;
  background: linear-gradient(145deg, rgba(113, 88, 232, 0.94), rgba(241, 117, 175, 0.9));
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  border-radius: 34rpx;
  box-shadow: 0 20rpx 54rpx rgba(109, 73, 190, 0.25);
}

.upload-kicker {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 5rpx;
  opacity: 0.72;
}

.upload-title {
  margin-top: 16rpx;
  font-size: 46rpx;
  font-weight: 700;
}

.upload-tip {
  margin: 12rpx 0 24rpx;
  font-size: 25rpx;
  opacity: 0.84;
}

.tag-picker {
  box-sizing: border-box;
  width: 100%;
  margin-bottom: 24rpx;
  padding: 22rpx 20rpx 20rpx;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  border-radius: 24rpx;
}

.tag-picker-title {
  display: block;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
  opacity: 0.9;
}

.tag-options {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
}

.tag-option {
  min-width: 96rpx;
  padding: 11rpx 18rpx;
  font-size: 24rpx;
  line-height: 1;
  text-align: center;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  border-radius: 999rpx;
}

.tag-option-active {
  color: #7657e6;
  font-weight: 700;
  background: rgba(255, 255, 255, 0.96);
  border-color: rgba(255, 255, 255, 0.96);
  box-shadow: 0 8rpx 18rpx rgba(84, 54, 157, 0.18);
}

.login-notice {
  margin-bottom: 20rpx;
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.16);
  border-radius: 999rpx;
}

.choose-button {
  width: 500rpx;
  color: #7456df;
  font-size: 29rpx;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.94);
  border-radius: 999rpx;
  box-shadow: 0 12rpx 30rpx rgba(79, 49, 159, 0.2);
}

.upload-icon {
  margin-right: 8rpx;
  color: #ff6f98;
  font-size: 36rpx;
}

.photoBox {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  width: 710rpx;
  margin-top: 28rpx;
  padding: 30rpx 24rpx 24rpx;
  background: rgba(255, 255, 255, 0.86);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 30rpx;
  box-shadow: 0 18rpx 50rpx rgba(103, 83, 168, 0.14);
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
  padding: 0 8rpx;
  color: #303249;
  font-size: 30rpx;
  font-weight: 600;
}

.photo-count {
  color: #9293a6;
  font-size: 24rpx;
  font-weight: 400;
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  overflow: hidden;
  border-radius: 22rpx;
}

.history-item {
  position: relative;
  width: 214rpx;
  height: 214rpx;
  overflow: hidden;
  border-radius: 16rpx;
}

.history-item image {
  display: block;
  width: 214rpx;
  height: 214rpx;
  background: #e9e5f3;
}

.history-tag {
  position: absolute;
  right: 10rpx;
  bottom: 10rpx;
  padding: 7rpx 14rpx;
  color: #ffffff;
  font-size: 20rpx;
  line-height: 1;
  background: rgba(47, 39, 73, 0.66);
  border-radius: 999rpx;
}

.history-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 20rpx;
  color: #8d8fa3;
  font-size: 28rpx;
  text-align: center;
}

.feed-status {
  height: 72rpx;
  color: #8d8fa3;
  font-size: 24rpx;
  line-height: 72rpx;
  text-align: center;
}
