.feed-page {
  padding-top: 28rpx;
}

.hero {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  width: 710rpx;
  margin-bottom: 20rpx;
  padding: 42rpx 36rpx 38rpx;
  color: #ffffff;
  background: linear-gradient(135deg, rgba(104, 77, 226, 0.94), rgba(255, 118, 157, 0.88));
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  border-radius: 32rpx;
  box-shadow: 0 20rpx 54rpx rgba(109, 73, 190, 0.25);
}

.filter-shell {
  box-sizing: border-box;
  width: 710rpx;
  margin-bottom: 26rpx;
  padding: 14rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 24rpx;
  box-shadow: 0 12rpx 34rpx rgba(103, 83, 168, 0.12);
}

.filter-bar {
  width: 100%;
  white-space: nowrap;
}

.filter-list {
  display: inline-block;
  white-space: nowrap;
}

.filter-chip {
  display: inline-block;
  min-width: 82rpx;
  margin-right: 12rpx;
  padding: 16rpx 22rpx;
  color: #77738c;
  font-size: 24rpx;
  line-height: 1;
  text-align: center;
  background: rgba(239, 233, 249, 0.86);
  border-radius: 999rpx;
}

.filter-chip:last-child {
  margin-right: 0;
}

.filter-chip-active {
  color: #ffffff;
  font-weight: 700;
  background: linear-gradient(135deg, #8064e8, #ed78ad);
  box-shadow: 0 8rpx 18rpx rgba(116, 83, 205, 0.24);
}

.hero-kicker {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 5rpx;
  opacity: 0.75;
}

.hero-title {
  margin-top: 16rpx;
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.hero-subtitle {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.7;
  opacity: 0.84;
}

.author-link {
  height: 92rpx;
}

.floatBtn {
  position: fixed;
  z-index: 10;
  right: 28rpx;
  bottom: 150rpx;
}

.upload-button {
  min-width: 184rpx;
  color: #ffffff;
  font-weight: 600;
  background: linear-gradient(135deg, #ff718f, #ff9d71);
  border-radius: 999rpx;
  box-shadow: 0 12rpx 30rpx rgba(238, 93, 127, 0.35);
}

.button-plus {
  margin-right: 6rpx;
  font-size: 32rpx;
  line-height: 1;
}

.feed-status {
  height: 72rpx;
  color: #88869b;
  font-size: 24rpx;
  line-height: 72rpx;
  text-align: center;
}
