<image class="page-background" src="/images/app-background.jpg" mode="aspectFill"></image>
<view class="container feed-page">
  <view class="hero">
    <text class="hero-kicker">PHOTO COMMUNITY</text>
    <text class="hero-title">发现生活里的光</text>
    <text class="hero-subtitle">收藏每一次心动，也把美好分享给世界</text>
  </view>

  <view class="filter-shell">
    <scroll-view class="filter-bar" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="filter-list">
        <view wx:for="{{photoTags}}" wx:key="*this" class="filter-chip {{activeTag === item ? 'filter-chip-active' : ''}}" data-tag="{{item}}" bindtap="selectTag">{{item}}</view>
      </view>
    </scroll-view>
  </view>

  <block wx:for="{{photoList}}" wx:key="_id">
    <view class="card">
      <view class="card-head">
        <view class="author-link" data-openid="{{item._openid}}" bindtap="openAuthor">
          <image wx:if="{{item.avatarUrl}}" class="avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image>
          <view wx:else class="avatar avatar-fallback">{{item.initial}}</view>
        </view>
        <view class="title">
          <text class="nickName">{{item.nickName}}</text>
        </view>
      </view>

      <navigator class="card-body" url="../detail/detail?id={{item._id}}">
        <image src="{{item.photoUrl}}" mode="widthFix" lazy-load="{{true}}"></image>
      </navigator>

      <view class="card-foot">
        <text class="card-tag">{{item.tag}}</text>
        <text>{{item.addDate}}</text>
      </view>
    </view>
  </block>

  <block wx:if="{{!loading}}">
    <view wx:if="{{!photoList.length}}" class="empty">
      <text class="empty-icon">▧</text>
      <text>{{errorText || emptyText}}</text>
      <button wx:if="{{errorText}}" class="retry-button" size="mini" bindtap="retryLoad">重新加载</button>
    </view>
  </block>

  <view wx:if="{{photoList.length}}" class="feed-status">
    <text wx:if="{{loadingMore}}">正在加载…</text>
    <text wx:elif="{{!hasMore}}">没有更多了</text>
  </view>
</view>

<view class="floatBtn">
  <button class="upload-button" size="mini" bindtap="goToAdd"><text class="button-plus">＋</text> 分享</button>
</view>
