.profile-page {
  padding-top: 28rpx;
}

.loginBox {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  width: 710rpx;
  margin: 0 0 24rpx;
  padding: 50rpx 36rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 32rpx;
  box-shadow: 0 18rpx 50rpx rgba(103, 83, 168, 0.16);
}

.login-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  color: #ffffff;
  font-size: 46rpx;
  background: linear-gradient(135deg, #8869f4, #ff86aa);
  border-radius: 32rpx;
  box-shadow: 0 12rpx 30rpx rgba(126, 88, 217, 0.26);
}

.login-title {
  margin-top: 24rpx;
  color: #303249;
  font-size: 34rpx;
  font-weight: 600;
}

.login-tip {
  margin: 12rpx 0 30rpx;
  color: #8d8fa3;
  font-size: 25rpx;
}

.login-button {
  width: 420rpx;
  color: #ffffff;
  font-weight: 600;
  background: linear-gradient(135deg, #7c5cf6, #a86ff0);
  border-radius: 999rpx;
  box-shadow: 0 12rpx 28rpx rgba(107, 76, 210, 0.26);
}

.avatarBox {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  width: 710rpx;
  margin-bottom: 24rpx;
  padding: 50rpx 30rpx 42rpx;
  background: rgba(255, 255, 255, 0.84);
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 32rpx;
  box-shadow: 0 18rpx 50rpx rgba(103, 83, 168, 0.14);
}

.avatarBox image,
.profile-fallback {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  border: 7rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 14rpx 34rpx rgba(104, 75, 185, 0.2);
}

.profile-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 64rpx;
  background: linear-gradient(135deg, #8c6ff7, #ff8fac);
}

.avatarBox > text {
  margin-top: 24rpx;
  color: #303249;
  font-size: 34rpx;
  font-weight: 600;
}

.avatarBox .count {
  margin-top: 10rpx;
  color: #8d8fa3;
  font-size: 24rpx;
  font-weight: 400;
}

.logout-button {
  margin-top: 16rpx;
  padding: 0 34rpx;
  color: #8b6cf4;
  font-size: 24rpx;
  background: rgba(139, 108, 244, 0.1);
  border-radius: 999rpx;
}

.edit-profile-button {
  margin-top: 28rpx;
  padding: 0 34rpx;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #8064e8, #ed78ad);
  border-radius: 999rpx;
  box-shadow: 0 10rpx 24rpx rgba(116, 83, 205, 0.2);
}

.profile-editor {
  box-sizing: border-box;
  width: 710rpx;
  margin-bottom: 24rpx;
  padding: 36rpx 30rpx 30rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 30rpx;
  box-shadow: 0 16rpx 44rpx rgba(103, 83, 168, 0.14);
}

.editor-title,
.editor-tip {
  display: block;
  text-align: center;
}

.editor-title {
  color: #303249;
  font-size: 32rpx;
  font-weight: 700;
}

.editor-tip {
  margin: 10rpx 0 28rpx;
  color: #8d8fa3;
  font-size: 23rpx;
  line-height: 1.6;
}

.profile-form {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-picker {
  position: relative;
  width: 154rpx;
  height: 154rpx;
  margin: 0 0 30rpx;
  padding: 0;
  overflow: visible;
  background: transparent;
  border-radius: 50%;
}

.avatar-picker image,
.editor-avatar-fallback {
  width: 154rpx;
  height: 154rpx;
  border-radius: 50%;
  box-shadow: 0 12rpx 28rpx rgba(104, 75, 185, 0.2);
}

.editor-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 54rpx;
  background: linear-gradient(135deg, #8c6ff7, #ff8fac);
}

.avatar-edit-mark {
  position: absolute;
  right: -10rpx;
  bottom: 0;
  padding: 8rpx 14rpx;
  color: #ffffff;
  font-size: 20rpx;
  line-height: 1;
  background: #7657d9;
  border: 4rpx solid #ffffff;
  border-radius: 999rpx;
}

.nickname-field {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  width: 100%;
  padding: 20rpx 24rpx;
  background: #f4effb;
  border: 1rpx solid #e7dcf6;
  border-radius: 20rpx;
}

.nickname-field > text {
  flex: none;
  margin-right: 22rpx;
  color: #5f5b70;
  font-size: 26rpx;
  font-weight: 600;
}

.nickname-field input {
  flex: 1;
  min-width: 0;
  color: #303249;
  font-size: 28rpx;
}

.editor-actions {
  display: flex;
  width: 100%;
  margin-top: 28rpx;
  gap: 18rpx;
}

.editor-actions button {
  flex: 1;
  margin: 0;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 999rpx;
}

.editor-cancel {
  color: #77738c;
  background: #f0ebf7;
}

.editor-save {
  color: #ffffff;
  background: linear-gradient(135deg, #8064e8, #ed78ad);
}

.feed-status {
  height: 72rpx;
  color: #8d8fa3;
  font-size: 24rpx;
  line-height: 72rpx;
}
