/**index.wxss**/
page {
  padding-top: 150rpx;
  width: 80%;
}

.intro{
  font-size: 14px;
  text-align: center;
  color: gray;
}

.body{
  padding: 30rpx;
  line-height: 1.8;
}

.title{
  text-align: center;
  font-size: 20px;
  font-weight: bold;
  color: darkblue;
